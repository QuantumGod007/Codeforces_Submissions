#include <iostream>
#include <cmath>
using namespace std;
 
void solve() {
    long long n;
    cin>>n;
    long long sum = 0;
    for(int i=0;i<n;i++) {
        long long val;
        cin >> val;
        sum += val;
    }
    long long root = sqrt(sum);
    if(root*root == sum) {
        cout << "YES
";
    }
    else {
        cout << "NO
";
    }
}
 
int main() {
    int tt;
    cin >> tt;
    while(tt--) {
        solve();
    }
    
    return 0;
}