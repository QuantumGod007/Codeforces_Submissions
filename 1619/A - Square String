#include <bits/stdc++.h>
using namespace std;
 
void solve() {
    string s;
    cin >> s;
    int n = s.length();
    if(n % 2 != 0) {
        cout << "NO
";
        return;
    }
 
    string a = "";
    string b = "";
    for(int i=0;i<n/2;i++) {
        a.push_back(s[i]);
    }
    for(int i=n/2;i<n;i++) {
        b.push_back(s[i]);
    }
    if(a==b) {
        cout << "YES
";
    }
    else {
        cout << "NO
";
    }
 
    
}
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
 
    int t;
    cin >> t;
 
    while(t--) {
        solve();
    }
 
    return 0;
}