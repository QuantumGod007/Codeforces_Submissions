#include <bits/stdc++.h>
using namespace std;
 
void solve() {
    long long n,k;
    cin >> n >> k;
    vector<long long> v(n);
    for(int i=0; i<n; i++) {
        cin >> v[i];
    }
    for(int i=0; i<n; i++) {
        if(v[i] == k) {
            cout << "YES
";
            return;
        }
    }
    cout << "NO
";
}
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
 
    int t;
    cin >> t;
 
    while(t--) {
        solve();
    }
 
    return 0;
}