#include <bits/stdc++.h>
using namespace std;
 
void solve() {
    string s;
    cin >> s;
    int suma = 0;
    int sumb = 0;
    suma += s[0] - '0';
    suma += s[1] - '0';
    suma += s[2] - '0';
    sumb += s[3] - '0';
    sumb += s[4] - '0';
    sumb += s[5] - '0';
    if(suma == sumb) {
        cout << "YES
";
    }
    else {
        cout << "NO
";
    }
 
}
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
 
    int t;
    cin >> t;
 
    while(t--) {
        solve();
    }
 
    return 0;
}