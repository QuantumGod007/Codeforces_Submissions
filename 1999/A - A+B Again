#include <bits/stdc++.h>
using namespace std;
 
void solve() {
    int n;
    cin >> n;
    int sum = 0;
    while(n > 0) {
        int digit = n % 10;
 
        sum += digit;
 
        n /= 10;
 
    }
 
    cout << sum << '
';
}
 
int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    cin >> t;
    while(t--) {
        solve();
    }
    return 0;
}